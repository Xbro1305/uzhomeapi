# --- База данных ---
MONGODB_URI=mongodb://127.0.0.1:27017/uzhome

# --- Админка ---
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Сервер ---
PORT=5000

# --- Приём остатков из 1С ---
# Токен выгрузки. Если задан — /api/stock/sync требует заголовок
# Authorization: Bearer <токен> (или X-Ingest-Token). На проде задан.
# Сгенерировать новый: openssl rand -hex 32
STOCK_INGEST_TOKEN=change-me-openssl-rand-hex-32

# --- Уведомления о заказах в Telegram (нужны для /api/orders, позже) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
